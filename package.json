{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment node --dir tests/unit",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "verify:database": "tsx scripts/verify-database.ts",
    "verify:services": "tsx scripts/verify-services.ts",
    "verify:sprint3:cloud": "tsx scripts/verify-sprint-3-cloud.ts",
    "verify:sprint5:cloud": "tsx scripts/verify-sprint-5-cloud.ts",
    "e2e:fixture:setup": "tsx scripts/sprint-1-e2e-fixture.ts setup",
    "e2e:fixture:verify": "tsx scripts/sprint-1-e2e-fixture.ts verify",
    "e2e:fixture:cleanup": "tsx scripts/sprint-1-e2e-fixture.ts cleanup",
    "e2e:sprint2:setup": "tsx scripts/sprint-2-e2e-fixture.ts setup",
    "e2e:sprint2:verify": "tsx scripts/sprint-2-e2e-fixture.ts verify",
    "e2e:sprint2:cleanup": "tsx scripts/sprint-2-e2e-fixture.ts cleanup",
    "e2e:sprint3:verify-pending": "tsx scripts/sprint-3-e2e.ts verify-pending",
    "e2e:sprint3:verify-approved": "tsx scripts/sprint-3-e2e.ts verify-approved",
    "e2e:sprint3:cleanup-storage": "tsx scripts/sprint-3-e2e.ts cleanup-storage",
    "e2e:sprint4:setup": "tsx scripts/sprint-4-e2e-fixture.ts setup",
    "e2e:sprint4:verify": "tsx scripts/sprint-4-e2e-fixture.ts verify",
    "e2e:sprint4:cleanup": "tsx scripts/sprint-4-e2e-fixture.ts cleanup",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "1.2.3",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "10.69.0",
    "@sentry/node": "10.69.0",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "@vercel/analytics": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.5.0",
    "lucide-react": "0.468.0",
    "next": "15.5.22",
    "posthog-js": "1.268.6",
    "posthog-node": "5.11.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "sharp": "0.35.0",
    "tailwind-merge": "2.6.0",
    "web-push": "^3.6.7",
    "zod": "3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.28.0",
    "eslint-config-next": "15.5.22",
    "husky": "9.1.7",
    "postcss": "8.5.23",
    "prettier": "3.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "$sharp"
  }
}
