# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Postgres: pooled runtime URL and direct migration URL
DATABASE_URL="postgresql://postgres.project:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project:password@host:5432/postgres"

# Observability (optional locally, required for cloud verification)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_PERSONAL_API_KEY=""

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sprint 3: seguro por defecto hasta aprobar un proveedor externo.
IMAGE_MODERATION_PROVIDER="deferred"

# Email transaccional opcional (sin estas variables se muestra un enlace copiable)
RESEND_API_KEY=""
INVITATION_FROM_EMAIL="Vela <invitaciones@example.com>"
